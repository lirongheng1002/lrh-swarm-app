@echo off
chcp 65001 >nul
title 安装 WSL Ubuntu（打包 APK 用）
echo ================================================================
echo   正在安装 WSL 的 Ubuntu 子系统，请耐心等待...
echo   全程 5~30 分钟（取决于网速），窗口会滚动安装日志。
echo   完成后会自动弹出 Ubuntu 的窗口或显示完成提示。
echo ================================================================
echo.
wsl --install -d Ubuntu
echo.
echo ================================================================
echo 上面如果显示 "The operation completed successfully" / "请求的操作成功"
echo 或弹出了 Ubuntu 窗口，说明安装成功！
echo 然后请回复我 "装好了"。
echo.
echo 如果提示需要重启电脑（Restart），请点开始菜单-电源-重启，
echo 重启后重新打开本软件告诉我。
echo ================================================================
pause
